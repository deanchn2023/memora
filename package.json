{
  "name": "memora",
  "version": "2.6.0",
  "description": "忆境 Memora - AI驱动的个人记忆与事项管理助手",
  "main": "main.js",
  "author": "Dean Zhu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "build:mac:dir": "electron-builder --mac --dir",
    "build:win:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.5",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.memora.app",
    "productName": "Memora",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Memora-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Memora-${version}-win-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": 2052,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Memora"
    },
    "asar": true,
    "asarUnpack": [
      "scripts/**",
      "resources/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "auditLogger.js",
      "clipboard/**",
      "src/**",
      "scripts/**",
      "prompts/**",
      "resources/**",
      "package.json",
      "!src/scripts/memory/memories.json",
      "!src/scripts/memory/entity-graph.json",
      "!src/scripts/notebook/notes.json",
      "!src/scripts/notebook/categories.json",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/*.sqlite3",
      "!**/feedback/**",
      "!**/backups/**",
      "!config-server/**",
      "!docs/**",
      "!dist/**"
    ]
  }
}
