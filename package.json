{
  "name": "memora",
  "version": "3.1.0",
  "description": "忆境 Memora - AI驱动的个人记忆与事项管理助手",
  "main": "main.js",
  "author": "Dean Zhu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "build:mac:dir": "electron-builder --mac --dir",
    "build:win:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.183",
    "@zvec/zvec": "^0.5.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.5",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.memora.app",
    "productName": "Memora",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Memora-${version}-mac.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Memora 需要访问麦克风以进行语音输入和实时语音识别。",
        "NSCameraUsageDescription": "Memora 需要访问摄像头以进行专注度检测。"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Memora-${version}-win-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": 2052,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Memora"
    },
    "asar": true,
    "asarUnpack": [
      "scripts/**",
      "resources/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/@zvec/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "auditLogger.js",
      "clipboard/**",
      "src/**",
      "scripts/**",
      "prompts/**",
      "resources/**",
      "package.json",
      "!src/scripts/memory/memories.json",
      "!src/scripts/memory/entity-graph.json",
      "!src/scripts/notebook/notes.json",
      "!src/scripts/notebook/categories.json",
      "!**/*.db",
      "!**/*.sqlite",
      "!**/*.sqlite3",
      "!**/feedback/**",
      "!**/backups/**",
      "!config-server/**",
      "!docs/**",
      "!dist/**"
    ]
  }
}
